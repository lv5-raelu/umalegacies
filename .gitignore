# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Test output
coverage/

# Environment
.env
.env.*
!.env.example

# Game data (user-provided, large, and personal — see README)
# Globbed, not exact: patch-day backups (.old, .bak, dated copies) are the same
# 16 MB of game data and the same personal save, and an exact-match rule misses
# every one of them.
# The game's master database. ~16 MB binary, sourced per-user from the Steam
# build's local files. It is the SOURCE for packages/api/data/master-extract.sql,
# which IS committed; the app runs from that and never needs this file.
# Kept out because 16 MB of binary that a patch rewrites wholesale would add
# ~4.4 MB to history per game update, permanently, and delta badly.
master.mdb*
# A player's trained-character export. Contains that player's own save data,
# including the trainer IDs of everyone they have borrowed from.
data.json*

# Character portraits, cached from gametora by packages/api/scripts/fetch-portraits.mjs
# into the web app's static folder, so a deploy uploads them and a CDN serves
# them. Still never committed: see NOTICE.md.
# Not committed, deliberately: these are Cygames' character illustrations, and
# gametora rehosts them rather than owning them, so nobody in that chain can
# grant redistribution rights. A local cache on the machine running the app is
# a different act from shipping them in git history and serving them publicly.
# Nothing depends on this directory -- a clean clone renders initials, which is
# the designed missing-image state.
packages/web/public/portraits/

# The rank badge atlas, cached from daftuyda.moe by scripts/fetch-rank-icons.mjs.
# Same reasoning as the portraits: Cygames' artwork, rehosted by a community site
# that cannot grant redistribution rights it does not hold. The COORDINATES that
# crop it are committed (packages/web/src/roster/rank-ladder.ts); the image is not.
packages/web/public/rank-icons/

# Logs
*.log
npm-debug.log*

# Local tooling state
.gstack/
.claude/
# Vercel's project link and local build output. The link file carries this
# machine's project/org ids; the build output is regenerated by `vercel build`.
.vercel/

