{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "services": {
    "web": {
      "root": "packages/web",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(search|roster|tree|compare)",
          "destination": "/index.html"
        }
      ]
    },
    "api": {
      "root": "packages/api",
      "runtime": "node",
      "buildCommand": "npm run build",
      "entrypoint": "src/main.ts",
      "installCommand": "cd ../.. && npm install"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
