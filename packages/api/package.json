{
  "name": "@umalegacies/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS API. Owns master.mdb and every affinity number.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm run build && { tsc -p tsconfig.json --watch --preserveWatchOutput & TSC=$!; trap 'kill $TSC 2>/dev/null' EXIT; node --watch dist/main.js; }",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:roster": "node scripts/check-roster.mjs",
    "build:fixtures": "node --import ts-node/esm scripts/build-fixtures.ts",
    "build:master": "node scripts/build-master-extract.mjs",
    "fetch:portraits": "node scripts/fetch-portraits.mjs",
    "fetch:rank-icons": "node scripts/fetch-rank-icons.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "@types/node": "22.20.2",
    "@umalegacies/types": "*",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
