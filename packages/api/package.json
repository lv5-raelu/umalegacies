{
  "name": "@umalegacies/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API. Owns master.mdb and every affinity number.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node --watch-path=src -r ts-node/register src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:roster": "node scripts/check-roster.mjs",
    "build:fixtures": "node scripts/build-fixtures.mjs",
    "build:master": "node scripts/build-master-extract.mjs",
    "fetch:portraits": "node scripts/fetch-portraits.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "better-sqlite3": "12.11.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.0",
    "@types/node": "22.20.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
