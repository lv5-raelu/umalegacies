{
  "name": "@umalegacies/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "React + Vite web app. Renders and inputs; no domain logic.",
  "scripts": {
    "predev": "npm run build --workspace @umalegacies/core --prefix ../..",
    "dev": "vite",
    "prebuild": "npm run build --workspace @umalegacies/core --prefix ../..",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "pretest": "npm run build --workspace @umalegacies/core --prefix ../..",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "npm run build --workspace @umalegacies/core --prefix ../..",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@umalegacies/core": "*"
  },
  "devDependencies": {
    "@types/react": "19.3.0 19.3.0",
    "@types/react-dom": "19.3.0 19.3.0",
    "@umalegacies/types": "*",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
